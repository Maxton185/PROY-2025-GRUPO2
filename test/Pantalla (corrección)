# =============================================
# DEFINICIÓN COMPLETA DE LA CLASE OLED_I2C (CORREGIDA)
# =============================================
class OLED_I2C:
    def __init__(self, width=128, height=64, scl_pin=22, sda_pin=21, addr=0x3C):
        self.i2c = machine.I2C(0, scl=machine.Pin(scl_pin), sda=machine.Pin(sda_pin))
        self.addr = addr
        self.width = width
        self.height = height
        self.pages = height // 8
        self.buffer = bytearray(self.pages * width)
        self.init_oled()
    
    def write_cmd(self, cmd):
        self.i2c.writeto(self.addr, bytearray([0x00, cmd]))
    
    def write_data(self, data):
        self.i2c.writeto(self.addr, b'\x40' + data)
    
    def init_oled(self):
        cmds = [
            0xAE,       0xD5, 0x80, 0xA8, self.height - 1,
            0xD3, 0x00, 0x40, 0x8D, 0x14,
            0x20, 0x00, 0xA1, 0xC8, 0xDA, 0x12 if self.width == 64 else 0x02,
            0x81, 0xCF, 0xD9, 0xF1, 0xDB, 0x30,
            0xA4, 0xA6, 0xAF
        ]
        for cmd in cmds:
            self.write_cmd(cmd)
        self.clear()
    
    def clear(self):
        self.buffer = bytearray(self.pages * self.width)
        self.flush()
    
    def flush(self):
        self.write_cmd(0x21)  # Set column address
        self.write_cmd(0x00)  # Start column
        self.write_cmd(self.width - 1)  # End column
        self.write_cmd(0x22)  # Set page address
        self.write_cmd(0x00)  # Start page
        self.write_cmd(self.pages - 1)  # End page
        self.write_data(self.buffer)
    
    def text(self, string, x, y):
        for char in string:
            self.char(char, x, y)
            x += 8  # Espacio entre caracteres
    
    def char(self, char, x, y):
        try:
            index = ord(char) * 5
            for col in range(5):
                col_data = FONT[index]
                index += 1
                for row in range(8):
                    if col_data & (1 << row):
                        self.pixel(x + col, y + row, 1)
        except:
            pass
    
    def pixel(self, x, y, state=1):
        if 0 <= x < self.width and 0 <= y < self.height:
            byte_index = (y // 8) * self.width + x
            bit_mask = 1 << (y % 8)
            if state:
                self.buffer[byte_index] |= bit_mask
            else:
                self.buffer[byte_index] &= ~bit_mask
                
    def rect(self, x, y, w, h, state=1):
        for i in range(x, x + w):
            for j in range(y, y + h):
                self.pixel(i, j, state)
    
    def fill_rect(self, x, y, w, h, state=1):
        for i in range(x, x + w):
            for j in range(y, y + h):
                self.pixel(i, j, state)
    
    def show(self):
        self.flush()

