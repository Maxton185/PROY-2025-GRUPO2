# Configuración para ESP32 (ajusta según tu placa)
SCL_PIN = 13
SDA_PIN = 12
OLED_ADDR = 0x3C  # Prueba con 0x3D si no funciona

try:
    # Buscar dispositivos I2C
    i2c = machine.I2C(0, scl=machine.Pin(SCL_PIN), sda=machine.Pin(SDA_PIN))
    devices = i2c.scan()
    
    if not devices:
        print("Error: No se detectaron dispositivos I2C")
        print("Verifica conexiones SDA y SCL")
    else:
        print("Dispositivos I2C encontrados:", [hex(d) for d in devices])
        
        if OLED_ADDR not in devices:
            print("Error: No se encontró dispositivo en", hex(OLED_ADDR))
            print("Probando con dirección 0x3D...")
            OLED_ADDR = 0x3D
            if OLED_ADDR not in devices:
                print("Error: No se encontró dispositivo en", hex(OLED_ADDR))
            else:
                print("Usando dirección alternativa", hex(OLED_ADDR))
    
    # Inicializar pantalla con TU clase OLED_I2C
    print("Inicializando pantalla OLED...")
    oled = OLED_I2C(scl_pin=SCL_PIN, sda_pin=SDA_PIN, addr=OLED_ADDR)
    print("¡Pantalla inicializada correctamente!")

    # Prueba 1: Texto básico
    oled.clear()
    oled.text("OLED FUNCIONA!", 15, 10)
    oled.text("MicroPython", 30, 30)
    oled.text("Direccion: " + hex(OLED_ADDR), 10, 50)
    oled.show()
    print("Mostrando texto básico...")
    time.sleep(3)

    # Prueba 2: Gráficos (CORREGIDO: eliminado el cuarto argumento)
    oled.clear()
    oled.rect(0, 0, 128, 64, 1)  # Borde exterior
    oled.fill_rect(20, 15, 88, 34, 1)  # Rectángulo central
    oled.rect(30, 25, 68, 14, 0)  # Agujero en el centro
    
    # CORRECCIÓN: Eliminado el cuarto argumento (0)
    oled.text("Graficos OK", 35, 28)
    
    oled.show()
    print("Mostrando gráficos...")
    time.sleep(3)

    # Prueba 3: Animación
    for i in range(0, 100, 5):
        oled.clear()
        oled.text("Test Animacion", 15, 5)
        oled.rect(i, 20, 20, 20, 1)  # Cuadrado moviendose
        oled.fill_rect(10, 50, i, 10, 1)  # Barra de progreso
        oled.show()
        time.sleep(0.1)
    
    # Mensaje final
    oled.clear()
    oled.text("Prueba completada!", 10, 25)
    oled.text("Exito!", 45, 40)
    oled.show()
    print("Prueba completada con éxito")

except Exception as e:
